# ─── Cervos Web — Environment Variables ──────────────────────────────────────
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local. The .gitignore already excludes it.

# ── Supabase (from dashboard.supabase.com → Project Settings → API) ──────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── HQ Console ────────────────────────────────────────────────────────────────
# Must be at least 32 characters long and random.
# Generate with: openssl rand -hex 32
# The cookie stores a derived HMAC token, never this raw value.
HQ_SECRET=generate-a-strong-secret-with-openssl-rand-hex-32

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-domain.com
