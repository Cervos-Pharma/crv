{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cervos Pharmacy OS",
  "version": "1.0.0",
  "identifier": "com.cervos.pharmacy-os",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devtools": true
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Cervos Pharmacy OS",
        "width": 1200,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://cdn.jsdelivr.net https://*.supabase.co https://api.cervos.io https://*.cervos.io; img-src 'self' data: blob:; worker-src 'self' blob:"
    },
    "splashscreen": {
      "imageSrc": "icons/icon.png",
      "imageWidth": 200,
      "imageHeight": 200,
      "center": true,
      "backgroundColor": "#6750A4"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "license": null,
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": ["English", "Swahili"],
        "promptElevationMode": "forceElevation",
        "startMenuFolder": "Cervos Pharmacy OS"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
